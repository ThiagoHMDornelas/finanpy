# Django
SECRET_KEY=troque-por-uma-chave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Superusuario (usado com createsuperuser --noinput)
# O login e por email e first_name e obrigatorio.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_FIRST_NAME=
DJANGO_SUPERUSER_PASSWORD=

# Agente de IA (opcional): sem OPENAI_API_KEY a geracao de analise fica indisponivel
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Docker (opcional): caminho do banco SQLite dentro do container
# SQLITE_PATH=/data/db.sqlite3
